{
  "openapi": "3.0.3",
  "info": {
    "title": "PowerTire Magento sales invoice API",
    "version": "1.2.0",
    "description": "Proposed contract; endpoint is not deployed or verified on PowerTire."
  },
  "servers": [
    {
      "url": "https://powertire.alphaxerp.com"
    }
  ],
  "components": {
    "securitySchemes": {
      "FrappeToken": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "token <api_key>:<api_secret>"
      }
    }
  },
  "security": [
    {
      "FrappeToken": []
    }
  ],
  "paths": {
    "/api/method/neo_connect.api.push": {
      "post": {
        "summary": "Create a complete-order invoice, optionally submit it",
        "parameters": [
          {
            "name": "endpoint",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "powertire-sales-invoice"
              ]
            }
          },
          {
            "name": "submit",
            "in": "query",
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ],
              "default": 0
            }
          },
          {
            "name": "dry_run",
            "in": "query",
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ],
              "default": 0
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "event",
                  "order_number",
                  "order_date",
                  "invoice_date",
                  "order_currency_code",
                  "customer",
                  "items",
                  "totals"
                ],
                "properties": {
                  "event": {
                    "type": "string",
                    "enum": [
                      "invoice.created"
                    ]
                  },
                  "order_number": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 140,
                    "description": "Stable unique order number across all stores for this partner."
                  },
                  "invoice_number": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 140
                  },
                  "order_date": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "invoice_date": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "order_currency_code": {
                    "type": "string",
                    "enum": [
                      "SAR"
                    ]
                  },
                  "customer": {
                    "type": "object",
                    "required": [
                      "firstname",
                      "email"
                    ],
                    "properties": {
                      "firstname": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 140
                      },
                      "email": {
                        "type": "string",
                        "format": "email"
                      }
                    }
                  },
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 500,
                    "items": {
                      "type": "object",
                      "required": [
                        "sku",
                        "qty_ordered",
                        "price",
                        "row_total",
                        "tax_amount"
                      ],
                      "properties": {
                        "sku": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 140
                        },
                        "qty_ordered": {
                          "type": "number",
                          "minimum": 0,
                          "exclusiveMinimum": true
                        },
                        "qty_invoiced": {
                          "type": "number",
                          "minimum": 0
                        },
                        "price": {
                          "type": "number",
                          "minimum": 0
                        },
                        "row_total": {
                          "type": "number",
                          "minimum": 0
                        },
                        "tax_amount": {
                          "type": "number",
                          "minimum": 0
                        },
                        "row_total_incl_tax": {
                          "type": "number",
                          "minimum": 0
                        },
                        "discount_amount": {
                          "type": "number",
                          "enum": [
                            0
                          ]
                        }
                      }
                    }
                  },
                  "totals": {
                    "type": "object",
                    "required": [
                      "subtotal",
                      "shipping_amount",
                      "tax_amount",
                      "grand_total"
                    ],
                    "properties": {
                      "subtotal": {
                        "type": "number",
                        "minimum": 0
                      },
                      "shipping_amount": {
                        "type": "number",
                        "minimum": 0
                      },
                      "shipping_tax_amount": {
                        "type": "number",
                        "minimum": 0
                      },
                      "tax_amount": {
                        "type": "number",
                        "minimum": 0
                      },
                      "grand_total": {
                        "type": "number",
                        "minimum": 0
                      },
                      "discount_amount": {
                        "type": "number",
                        "enum": [
                          0
                        ]
                      }
                    }
                  },
                  "payment": {
                    "type": "object",
                    "properties": {
                      "method": {
                        "type": "string"
                      },
                      "amount_paid": {
                        "type": "number",
                        "minimum": 0
                      },
                      "transaction_id": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "example": {
                "order_number": "PT-289335",
                "order_date": "2026-09-15T10:30:00Z",
                "status": "processing",
                "custom_order_status": "Awaiting Installer",
                "erp_executive_code": "EXC-001",
                "customer": {
                  "email": "ahmed@example.com",
                  "firstname": "Ahmed Al-Rashidi",
                  "is_guest": false
                },
                "billing_address": {
                  "firstname": "Ahmed Al-Rashidi",
                  "street": "King Fahad Road, Building 5",
                  "city": "Riyadh",
                  "postcode": "12271",
                  "country_id": "SA",
                  "telephone": "+966501234567"
                },
                "vehicle": {
                  "make": "Toyota",
                  "model": "Camry",
                  "year": "2022",
                  "plate": "ABC 1234",
                  "vin_number": "1HGBH41JXMN109186"
                },
                "fulfillment": {
                  "method": "Store Pickup",
                  "pickup_date": "2026-09-20T00:00:00Z",
                  "pickup_time": "10:00 AM - 12:00 PM"
                },
                "installer": {
                  "name": "PowerTire Riyadh North",
                  "name_ar": "باور تاير شمال الرياض",
                  "address": "King Fahad Road, Building 5",
                  "address_ar": "طريق الملك فهد، مبنى 5",
                  "city": "Riyadh",
                  "city_ar": "الرياض",
                  "country": "SA",
                  "phone": "+966114567890",
                  "email": "riyadhnorth@powertire.sa",
                  "latitude": "24.7136",
                  "longitude": "46.6753",
                  "installer_type": "branch",
                  "is_mobilevan": false
                },
                "items": [
                  {
                    "sku": "TYR-MICH-2254517-XL",
                    "name": "Michelin Pilot Sport 4 225/45R17 XL",
                    "qty_ordered": 4,
                    "qty_invoiced": 4,
                    "price": 450.0,
                    "price_incl_tax": 517.5,
                    "row_total": 1800.0,
                    "row_total_incl_tax": 2070.0,
                    "tax_amount": 270.0,
                    "discount_amount": 0.0,
                    "brand": "Michelin",
                    "width": "225",
                    "height": "45",
                    "rim": "17",
                    "speed_index": "W",
                    "supplier_item_code": "MC-PS4-225"
                  }
                ],
                "totals": {
                  "subtotal": 1800.0,
                  "shipping_amount": 0.0,
                  "shipping_tax_amount": 0.0,
                  "discount_amount": 0.0,
                  "tax_amount": 270.0,
                  "grand_total": 2070.0
                },
                "payment": {
                  "method": "tap",
                  "method_title": "TAP Payment",
                  "amount_paid": 2070.0,
                  "transaction_id": "ch_3abc123xyz"
                },
                "event": "invoice.created",
                "invoice_number": "PT-INV-289335",
                "invoice_date": "2026-09-16T10:30:00Z",
                "order_currency_code": "SAR"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created, submitted, validated dry run, or duplicate; inspect message.results and docstatus"
          },
          "400": {
            "description": "Rejected request"
          },
          "401": {
            "description": "Authentication failure"
          },
          "403": {
            "description": "Partner or permission failure"
          },
          "413": {
            "description": "More than one record or body larger than 2000000 bytes"
          },
          "422": {
            "description": "Invoice failed validation; nothing saved for this record"
          },
          "429": {
            "description": "Rate limit exceeded"
          },
          "500": {
            "description": "Framework or unexpected server error; invalid JSON may be rejected before app logging"
          }
        }
      }
    },
    "/api/method/neo_connect.api.ping": {
      "get": {
        "summary": "Check API partner credentials",
        "responses": {
          "200": {
            "description": "Partner and endpoints"
          }
        }
      }
    },
    "/api/method/neo_connect.api.submit": {
      "post": {
        "summary": "Submit an invoice already imported for this partner",
        "parameters": [
          {
            "name": "endpoint",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "powertire-sales-invoice"
              ]
            }
          },
          {
            "name": "dry_run",
            "in": "query",
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ],
              "default": 0
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "order_number"
                ],
                "properties": {
                  "order_number": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 140
                  }
                }
              },
              "example": {
                "order_number": "PT-289335"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created, submitted, validated dry run, or duplicate; inspect message.results and docstatus"
          },
          "400": {
            "description": "Rejected request"
          },
          "401": {
            "description": "Authentication failure"
          },
          "403": {
            "description": "Partner or permission failure"
          },
          "413": {
            "description": "More than one record or body larger than 2000000 bytes"
          },
          "422": {
            "description": "Invoice failed validation; nothing saved for this record"
          },
          "429": {
            "description": "Rate limit exceeded"
          },
          "500": {
            "description": "Framework or unexpected server error; invalid JSON may be rejected before app logging"
          },
          "404": {
            "description": "No imported order for this partner"
          },
          "409": {
            "description": "Cancelled, deleted or changed source invoice"
          }
        }
      }
    }
  }
}